# Local database. SQLite is used for the first working version.
DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development
API_PREFIX=/api/v1

# Optional Gemini report generation. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Required before deployment. Use a long random value and never commit it.
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
AUTH_TOKEN_TTL_HOURS=24
