# ==============================================================================
# LLM-DPECI ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This is a public template committed to Git.
# Copy this file to .env and put your REAL credentials in .env:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose ONE of the options below:

# ---> OPTION A: Free Cloud MySQL (e.g., TiDB Cloud, Aiven) <---
# DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DBNAME?charset=utf8mb4

# ---> OPTION B: Local MySQL / XAMPP (running on your PC) <---
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/dpeci_db?charset=utf8mb4

# ---> OPTION C: Local SQLite (Default - no database server needed) <---
DATABASE_URL=sqlite:///./data/app.db

# ------------------------------------------------------------------------------
# 2. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (For Executive Reports)
# ------------------------------------------------------------------------------
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
AUTH_TOKEN_TTL_HOURS=24
